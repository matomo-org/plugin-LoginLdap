parameters:
    level: 5
    phpVersion: 80100
    tmpDir: /tmp/phpstan/LoginLdap/main
    paths:
        - .
    excludePaths:
        - tests/*
        - vendor/ (?)
        - github-action-tests/ (?)
    ignoreErrors:
        # released update files are immutable history and must not be edited for analysis findings
        - message: '#^Parameter \#2 \$value of static method Piwik\\Option::set\(\) expects string, int given\.$#'
          path: Updates/3.0.0.php
        - message: '#^Property Piwik\\Plugins\\LoginLdap\\Updates_4_7_3::\$migration is never read, only written\.$#'
          path: Updates/4.7.3.php
        # the version guard is constant-folded against core's version: always true on 6.1.0 and later,
        # always false on the minimum-required Matomo analysed by CI, so each leg reports only one of them
        - identifier: ternary.alwaysTrue
          path: LoginLdap.php
          count: 1
          reportUnmatched: false
        - identifier: ternary.alwaysFalse
          path: LoginLdap.php
          count: 1
          reportUnmatched: false
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        - ../../
